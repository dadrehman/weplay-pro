{
  "name": "weplay-backend",
  "version": "1.0.0",
  "description": "WePlay-Pro Backend API & Real-time Server",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/generate_build_info.js && prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "generate": "node ./node_modules/prisma/build/index.js generate --schema=./prisma/schema.prisma",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "agora-access-token": "^2.0.4",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1"
  }
}
